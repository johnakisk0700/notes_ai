    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@qdrant/qdrant-js": "^1.14.1",
    "@types/pg": "^8.15.4",
    "ai": "^6.0.191",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "cron": "^4.3.1",
    "decimal.js": "^10.5.0",
