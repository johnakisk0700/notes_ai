  "scripts": {
    "start": "bun run dist/server.js",
    "dev": "bun --watch run server.ts",
    "dev:poll": "nodemon --legacy-watch --watch . --watch ../shared --ext ts,tsx,js,json --exec \"bun run server.ts\"",
    "dev-eu": "bun run server.ts",
    "build": "bun build ./server.ts --outdir ./dist --target bun --minify --external pino-pretty",
