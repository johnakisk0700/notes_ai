#Mode
MODE=

#Server
APP_PORT=

#OpenAi key
OPENAI_API_KEY=

# OpenRouter — agentic chat (default Qwen3.6-Plus / GLM-5.1) AND note embeddings
# (google/gemini-embedding-001, used to index + search notes — see clients/embedding_client.ts).
# If unset, chat falls back to gpt-5-mini on OPENAI_API_KEY and note embedding/search is disabled.
OPENROUTER_API_KEY=

# Jina (optional) — enables relevance reranking of note search (jina-reranker-v2-base-multilingual).
# If unset, search_notes falls back to vector order (top NOTES_FINAL_K).
JINA_API_KEY=

#Clerk authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Mongo
MONGODB_URI=

# Postgres
POSTGRES_URI=

#Azure OpenAI Key
AZURE_GPT4o_KEY=

CNCLV_SERVER=

#Google Voice Key
GOOGLE_VOICE_KEY=
