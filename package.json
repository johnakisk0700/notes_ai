{
  "name": "ai-agents-project",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "docker compose up",
    "dev:rebuild": "docker compose up --build --renew-anon-volumes",
    "dev:down": "docker compose down",
    "prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d",
    "prod:down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml down",
    "logs": "docker compose logs -f",
    "deploy": "bun deploy.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "log-update": "^6.1.0",
    "tailwindcss": "^4.1.10",
    "drizzle-orm": "^0.44.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.16",
    "bun-types": "^1.2.16"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "protobufjs"
  ]
}
