# Root-level variables read automatically by `docker compose`.
# Copy to .env and fill in. Backend secrets/API keys live separately in backend/.env.

# Clerk publishable key — inlined into the frontend (dev server + prod build).
VITE_CLERK_PUBLISHABLE_KEY=

# Frontend -> backend API base URL.
VITE_API_DEV_URL=http://localhost:5100/api/
# Baked into the static assets by the prod build:
VITE_API_URL=http://localhost:5100/api/

# Backend TLS mode for the prod compose: "production" (HTTPS, reads certs from
# /etc/letsencrypt) or "dev" (plain HTTP, e.g. behind an upstream TLS proxy).
BACKEND_MODE=production
