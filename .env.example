# Root-level variables read automatically by `docker compose` (and by deploy.ts when
# building the frontend). Copy to .env and fill in. Backend secrets/API keys live
# separately in backend/.env.

# Clerk publishable key — inlined into the frontend build (public by design).
# Use the Clerk *production* instance key when building for mneme.narusec.io.
VITE_CLERK_PUBLISHABLE_KEY=

# Frontend -> backend API base URL (api.ts: dev uses *_DEV_URL, prod build uses *_PROD_URL).
VITE_API_DEV_URL=http://localhost:5100/api/
# Baked into the static build. Leave empty for local container builds (compose
# defaults to localhost:5100); deploy.ts builds the real prod SPA with
# https://mneme.narusec.io/api/ (same-origin behind the native nginx).
VITE_API_PROD_URL=

# Backend TLS for the prod compose. "off" (default) = serve plain HTTP because the
# native host nginx terminates TLS and proxies to 127.0.0.1:5100. Set to "on" only to
# have the backend serve HTTPS directly (then it reads the TLS_*_PATH certs).
BACKEND_TLS=off

# Dev-only login bypass. Set to "true" to open the app without signing in: the backend
# (verifyJWT) authenticates every request as a fixed local "Dev User" (admin) and the
# frontend skips the Clerk gate. This single switch drives both containers (compose maps
# it to VITE_DEV_AUTH_BYPASS for the frontend). Only honoured in the dev stack (MODE=dev)
# — it can NEVER engage in prod (MODE=production). Changing it needs the backend +
# frontend containers recreated. TURN IT OFF when you're done. See docs/auth.md.
DEV_AUTH_BYPASS=
